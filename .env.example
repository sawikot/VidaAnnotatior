# Copy this file to .env in the project root and adjust as needed.
# All paths are resolved relative to the project root if not absolute.

# SQLAlchemy database URL. SQLite by default; swap for a Postgres URL later
# (e.g. postgresql+psycopg://user:pass@localhost:5432/virtualpatch) without any
# code changes -- the ORM layer is DB-agnostic.
DATABASE_URL=sqlite:///./data/database/app.db

# Directory the app manages: imported WSI files, cached tissue masks, etc.
# Never write anything else here manually -- the app owns this directory.
WSI_STORAGE_DIR=./data/uploads

# Directory the "register local path" slide-import mode is allowed to read
# from. Any path outside this directory is rejected (prevents arbitrary
# filesystem access via the API). Point this at wherever your lab keeps raw
# scanner output, e.g. C:\Pathology\Incoming
WSI_WATCH_DIR=./data/watch

# Comma-separated list is not supported here; edit core/config.py's default
# list directly if you need more than the Vite dev server origin.

# Signing in: set to true when the app is reached over HTTPS (it should be, on a network).
COOKIE_SECURE=false
# How long a sign-in lasts, in days.
SESSION_DAYS=14

# ------------------------------------------------------------------ Docker install (docker-compose.yml)
# Port the app is opened on: http://<this machine>:8088
PORT=8088
# The version running. The app's "Version & updates" page changes this; no need to edit it by hand.
APP_VERSION=latest
# Where versions come from. While the repository is private, GITHUB_TOKEN must be a GitHub token
# (classic) with the "repo" and "read:packages" scopes. Leave it empty once the repository is public.
GITHUB_REPO=sawikot/VidaAnnotatior
GITHUB_TOKEN=
# Folder on this machine the "import from a path" option may read slides from (default: data/watch).
# SLIDES_DIR=/mnt/scanner/slides
